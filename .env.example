# ==========================================
# .env.example — docker-app-ai (Open WebUI + Ollama)
#
# Usage:
#   cp .env.example .env    # then fill in real values and open in ./README.md
#
# IMPORTANT:
#   - .env is git-ignored by design. NEVER commit real secret values.
#   - All values below are safe placeholders that can be committed as-is.
# ==========================================

# ==========================================
# Image versions
#   Prefer pinning explicit release tags / digests in production
#   (the compose file + --force-recreate make tag changes atomic).
# ==========================================
OLLAMA_VERSION=latest
OPEN_WEBUI_VERSION=main

# ==========================================
# Security
#   Master secret Open WebUI uses to sign sessions / JWTs.
#   - Unique per installation; NEVER copy between environments.
#   - Changing it after first use invalidates all existing logins.
#   Generate a strong value, e.g.:
#     openssl rand -hex 32
#   Paste the result in place of the placeholder below (in a real .env, not here).
# ==========================================
WEBUI_SECRET_KEY=__REPLACE_WITH_64_HEX_CHARS_FROM_openssl_rand_-hex_32__

# ==========================================
# Option A: Local Deployment (No Traefik)
# ==========================================
# The host port used to access Open WebUI locally (e.g., http://localhost:3000).
# Only used when the 'ports' block is active in docker-compose.yaml.
WEBUI_LOCAL_PORT=3000

# ==========================================
# Option B: Traefik Deployment Variables
# ==========================================
# The subdomain used to access the AI UI and API. Must have a DNS A/AAAA record
# pointing at your Traefik host before this deployment will route correctly.
DOMAIN_NAME=ai.example.com

# The NAME OF AN EXISTING external Traefik Docker network (e.g., 'proxy').
# Compose consumes this network — it must already exist on the host.
TRAEFIK_NETWORK=proxy

# Your Traefik entrypoint name (e.g., https, websecure).
TRAEFIK_ENTRYPOINT=https

# Your Traefik certificate resolver name (e.g., letsencrypt, cloudflare).
TRAEFIK_CERTRESOLVER=letsencrypt
